# Copy this file to .env and fill in your own values.
# Never commit the .env file.

PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/mockmate

# Any long random string used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# Primary Gemini model
GEMINI_MODEL=gemini-3.8-flash

# Backup models (comma-separated) used when the primary model is busy
GEMINI_BACKUP_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite

# true = use the question bank and basic scoring when the AI is unavailable
AI_FALLBACK=true

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173

# true = run without calling the AI (development only)
AI_MOCK=false
