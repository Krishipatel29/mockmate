# Is file ki copy banao aur naam rakho: .env
# Phir neeche ki values apni daalo. .env file kabhi GitHub par mat daalna.

PORT=5000

# Local MongoDB (Compass wala): mongodb://127.0.0.1:27017/mockmate
# Ya MongoDB Atlas -> Connect -> Drivers se connection string (password ke saath)
MONGO_URI=mongodb://127.0.0.1:27017/mockmate

# Koi bhi lamba random text (token sign karne ke liye)
JWT_SECRET=change_this_to_a_long_random_text

# Google AI Studio se mili key
GEMINI_API_KEY=paste_your_key_here

# Model ka naam. Error aaye to AI Studio mein jo flash model dikhe uska naam daalo
GEMINI_MODEL=gemini-3.8-flash

# Main model busy ho to ye backup models (comma se alag) try hote hain
GEMINI_BACKUP_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite

# true = AI busy ho to practice questions + basic scoring se app chalti rahe (Plan B)
AI_FALLBACK=true

# Frontend ka address (CORS ke liye)
CLIENT_URL=http://localhost:5173

# true = bina AI key ke testing (nakli questions/score). Real use ke liye false
AI_MOCK=false
